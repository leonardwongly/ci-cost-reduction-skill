    {
      "name": "linux-32core",
      "match": "(ubuntu|linux).*(32[- ]?(core|cpu|vcpu)|[-_]32($|,))|(^|[-_])32vcpu",
      "per_minute": 0.128
    },
    {
      "name": "linux-16core",
      "match": "(ubuntu|linux).*(16[- ]?(core|cpu|vcpu)|[-_]16($|,))|(^|[-_])16vcpu",
      "per_minute": 0.064
    },
    {
      "name": "linux-8core",
      "match": "(ubuntu|linux).*(8[- ]?(core|cpu|vcpu)|[-_]8($|,))|(^|[-_])8vcpu",
      "per_minute": 0.032
    },
    {
      "name": "linux-4core",
      "match": "(ubuntu|linux).*(4[- ]?(core|cpu|vcpu)|[-_]4($|,))|(^|[-_])4vcpu",
      "per_minute": 0.016
