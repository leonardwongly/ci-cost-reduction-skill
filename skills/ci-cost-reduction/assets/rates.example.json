{
  "_note": "EXAMPLE RATES. Replace every per_minute with what this team actually pays (provider price page, plan discounts, included minutes, amortised self-hosted cost). Rules are tried in order: the first regex that matches the job's comma-joined runner labels wins. Unmatched jobs are reported as 'unpriced'.",
  "currency": "USD",
  "round_up_per_job": true,
  "rates": [
    {
      "name": "self-hosted (amortised)",
